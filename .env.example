# API key for the API answer writer (Nemotron on NVIDIA NIM).
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: any other OpenAI-compatible endpoint.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Use Nyaya-Gen, the local answer writer trained in this project (no key needed).
# LLM_BACKEND=local
# NYAYA_GEN_PATH=models/nyaya-gen

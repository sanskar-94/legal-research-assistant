# API key for the answer-generation LLM.
# Get a free key at https://build.nvidia.com (DeepSeek V3.2 is served through NVIDIA NIM).
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: use any other OpenAI-compatible endpoint instead.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=deepseek-ai/deepseek-v3.2
# LLM_API_KEY=

# Or run LFM3-1.7B locally with llama.cpp (no key needed). See README, "Running locally".
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=LFM3-1.7B
